# Copy to server/.env and fill in. Never commit the real .env.

# "npm run dev" forces development and "npm start" forces production, so this only matters
# when running node directly.
NODE_ENV=development
PORT=5000
# Origin allowed by CORS (the Vite dev server in development, the Vercel URL in production)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas > Connect > Drivers), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mychatgpt?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# Optional. DNS resolvers used for the mongodb+srv:// SRV lookup, comma-separated IPs.
# Some ISP/router DNS servers refuse SRV queries (error: "querySrv ECONNREFUSED"), so the
# server resolves the Atlas SRV record through these instead. Defaults to 8.8.8.8,1.1.1.1.
# Ignored for plain mongodb:// URIs and in production (NODE_ENV=production).
DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT secrets: long random strings (32+ chars), different from each other.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=your_long_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_different_long_random_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini API key (server only). Free key: https://aistudio.google.com/apikey
# Models are set in src/config/aiModels.js (free-tier Flash models).
GEMINI_API_KEY=your_gemini_api_key_here
